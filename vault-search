#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["tomli; python_version<'3.11'", "sqlite-vec", "fastembed"]
# ///
"""vault-search — hybrid index over everything Jason has written, read or collected,
so the prior-coverage and corrections rules stop depending on guessing the right grep.

Retrieval is a LOCATOR, not an answerer: it returns paths, line ranges and enough
context to judge relevance, and the model then reads the actual file. Chunk boundaries
mangle quotations, and the standing rule is to preserve exact quotes from source
material — answering from fragments is how a subtly wrong quote ends up looking sourced.

Two modes with opposite optimisations:
  find  — top-k, ranked, precision. "What do I know about X."
  sweep — everything above a low threshold, unranked, recall. "Where does this claim
          appear." The corrections protocol needs this one; a top-10 result set is
          actively wrong for it.

Spec and measurements: ~/notebook/pages/vault-search.md
"""
import os, re, sys, json, time, sqlite3, hashlib, pathlib, fnmatch, argparse

try:
    import tomllib
except ModuleNotFoundError:
    import tomli as tomllib

HOME = pathlib.Path.home()
MANIFEST = HOME/".config/vault-search/manifest.toml"
DB = HOME/".local/state/vault-search.db"      # outside the vault: a vector store inside
                                              # a repo with hourly autocommit is a disaster
TARGET_CHARS = 2000
MAX_CHARS = 6000      # hard ceiling: a file with no blank lines must still split
MIN_CHUNK = 200
EMBED_MODEL = "BAAI/bge-small-en-v1.5"
# Each fastembed worker loads its OWN copy of the ONNX model, ~1.4GB resident. With
# parallel=0 that is one worker per core: 32 workers = ~45GB, which took a 92GB
# machine into swap at 93% and load 40. Cap it, and size it against free memory
# rather than core count.
EMBED_WORKERS = 16    # ceiling; the real number is min(this, memory, cores-6)
SLICE = 5000          # commit progress every N chunks; bounds parent memory too
EMBED_DIM = 384
RRF_K = 60          # reciprocal-rank-fusion constant; ranks, not scores, so the
                    # bm25 and cosine scales never have to be reconciled


# ── manifest ──────────────────────────────────────────────────────────────────

def load_manifest():
    with open(MANIFEST, "rb") as f:
        m = tomllib.load(f)
    lim = m.get("limits", {})
    return {
        "exts": {e.lower().lstrip(".") for e in lim.get("extensions", ["md"])},
        "max_bytes": int(lim.get("max_file_mb", 8) * 1024 * 1024),
        "min_chars": int(lim.get("min_chars", 120)),
        "excludes": lim.get("exclude_globs", []),
        "roots": m.get("root", []),
    }


def tier_for(rel, root):
    for t in root.get("tier", []):
        if fnmatch.fnmatch(rel, t["glob"]) or fnmatch.fnmatch(rel, t["glob"].rstrip("/*") + "/*"):
            return t["tier"]
    return root.get("default_tier", "notes")


def scan(man):
    """Yield (path, root_path, tier). Exclusion is by size and path, never by category —
    Reader's Pdf category is half primary-source documents."""
    seen = set()
    for root in man["roots"]:
        rp = pathlib.Path(os.path.expanduser(root["path"]))
        if not rp.is_dir():
            print(f"vault-search: root missing, skipped: {rp}", file=sys.stderr); continue
        rp = rp.resolve()
        for dirpath, dirnames, filenames in os.walk(rp):
            d = pathlib.Path(dirpath)
            rel_dir = str(d.relative_to(rp))
            if any(fnmatch.fnmatch(str(d/"x"), g) for g in man["excludes"]):
                dirnames[:] = []; continue
            for fn in filenames:
                p = d/fn
                if p.suffix.lower().lstrip(".") not in man["exts"]: continue
                rel = str(p.relative_to(rp))
                if any(fnmatch.fnmatch(rel, g) or fnmatch.fnmatch(str(p), g) for g in man["excludes"]):
                    continue
                try:
                    st = p.stat()
                except OSError:
                    continue
                if st.st_size > man["max_bytes"] or st.st_size < man["min_chars"]:
                    continue
                rp_res = p.resolve()
                if rp_res in seen: continue     # ~/Guardian was a symlink to ~/Investigations
                seen.add(rp_res)
                yield p, rp, tier_for(rel, root)


# ── parsing and chunking ──────────────────────────────────────────────────────

FM_RE = re.compile(r'^---\s*\n(.*?)\n---\s*\n?', re.S)
LINK_RE = re.compile(r'\[\[([^\]|#]+)')


def split_frontmatter(text):
    m = FM_RE.match(text)
    return (m.group(1), text[m.end():], text[:m.end()].count("\n")) if m else ("", text, 0)


def parse_frontmatter(fm):
    out, key = {}, None
    for line in fm.splitlines():
        if re.match(r'^[A-Za-z_][A-Za-z0-9_-]*:', line):
            key, _, val = line.partition(":")
            key = key.strip(); val = val.strip().strip('"\'')
            if val.startswith("["):
                out[key] = [x.strip().strip('"\'') for x in val.strip("[]").split(",") if x.strip()]
            elif val:
                out[key] = val
            else:
                out[key] = []
        elif key and re.match(r'^\s*-\s+', line):
            v = re.sub(r'^\s*-\s+', '', line).strip().strip('"\'')
            if isinstance(out.get(key), list): out[key].append(v)
            else: out[key] = [v]
    return out


def chunk(text, offset=0):
    """Markdown-aware: split on headings, pack to TARGET_CHARS, break at a blank line
    where one exists and at MAX_CHARS where one does not.

    Three failure modes this guards against, all found in the first real index:
      - A file with no blank lines used to become ONE chunk of the whole file. The
        worst case in the live corpus was 6,041,077 characters. bge-small truncates
        at 512 tokens, so ~99.9% of that document was semantically invisible.
      - A trailing fragment under MIN_CHUNK was dropped, losing the tail of every
        section that did not divide evenly.
      - A document shorter than MIN_CHUNK produced NO chunks at all: it existed in
        `documents`, was counted in `stat`, and could never be found. 698 documents
        were in that state.

    Yields (heading, text, start_line, end_line)."""
    lines = text.splitlines()
    sections, cur, head, start = [], [], "", 0
    for i, ln in enumerate(lines):
        if re.match(r'^#{1,6}\s+\S', ln):
            if cur or head: sections.append((head, cur, start))
            head, cur, start = ln.lstrip("#").strip(), [], i
        else:
            cur.append(ln)
    if cur or head: sections.append((head, cur, start))

    out = []
    for head, body, start in sections:
        buf, buf_start = [], start
        for i, ln in enumerate(body):
            if buf and sum(len(x) + 1 for x in buf) + len(ln) > MAX_CHARS:
                t = "\n".join(buf).strip()
                if t: out.append([head, t, offset + buf_start + 1, offset + start + i + 1])
                buf, buf_start = [], start + i
            buf.append(ln)
            size = sum(len(x) + 1 for x in buf)
            # Break at a blank line once big enough, OR force a break at the hard
            # ceiling so a file without blank lines cannot produce one vast chunk.
            if (size >= TARGET_CHARS and not ln.strip()) or size >= MAX_CHARS:
                t = "\n".join(buf).strip()
                if t: out.append([head, t, offset + buf_start + 1, offset + start + i + 1])
                buf, buf_start = [], start + i
        t = "\n".join(buf).strip()
        if t: out.append([head, t, offset + buf_start + 1, offset + start + len(body) + 1])

    # Merge a short tail into its predecessor rather than dropping it.
    merged = []
    for c in out:
        if merged and len(c[1]) < MIN_CHUNK and merged[-1][0] == c[0]:
            merged[-1][1] += "\n" + c[1]; merged[-1][3] = c[3]
        else:
            merged.append(c)
    # A document with any content always yields at least one chunk.
    if not merged:
        t = text.strip()
        if t: merged = [["", t, offset + 1, offset + len(lines) + 1]]

    # Final guard: hard-split on character count. Line-based splitting cannot help a
    # file that is ONE line — the worst case in the live corpus was a single
    # 6,041,077-character line, which line splitting left entirely intact.
    for h, t, a, b in merged:
        if len(t) <= MAX_CHARS:
            yield h, t, a, b
        else:
            for i in range(0, len(t), MAX_CHARS):
                yield h, t[i:i + MAX_CHARS], a, b


# ── database ──────────────────────────────────────────────────────────────────

SCHEMA = """
CREATE TABLE IF NOT EXISTS documents(
  id INTEGER PRIMARY KEY, path TEXT UNIQUE, root TEXT, tier TEXT,
  mtime REAL, hash TEXT, title TEXT, date TEXT, indexed_at REAL);
CREATE TABLE IF NOT EXISTS chunks(
  id INTEGER PRIMARY KEY AUTOINCREMENT, doc_id INTEGER, ord INTEGER, heading TEXT,
  text TEXT, start_line INTEGER, end_line INTEGER,
  FOREIGN KEY(doc_id) REFERENCES documents(id) ON DELETE CASCADE);
CREATE TABLE IF NOT EXISTS meta(doc_id INTEGER, key TEXT, value TEXT);
CREATE TABLE IF NOT EXISTS links(doc_id INTEGER, target TEXT);
CREATE INDEX IF NOT EXISTS ix_chunks_doc ON chunks(doc_id);
CREATE INDEX IF NOT EXISTS ix_meta_kv ON meta(key, value);
CREATE INDEX IF NOT EXISTS ix_links_t ON links(target);
CREATE VIRTUAL TABLE IF NOT EXISTS chunks_fts USING fts5(
  text, content='chunks', content_rowid='id', tokenize='porter unicode61');
"""


def connect(vec=False):
    DB.parent.mkdir(parents=True, exist_ok=True)
    c = sqlite3.connect(DB)
    c.executescript(SCHEMA)
    if vec and load_vec(c):
        c.execute(f"CREATE VIRTUAL TABLE IF NOT EXISTS vec_chunks USING vec0("
                  f"chunk_id INTEGER PRIMARY KEY, embedding FLOAT[{EMBED_DIM}])")
    return c


def load_vec(c):
    """sqlite-vec is a loadable extension; Python's sqlite3 here has
    enable_load_extension available (verified 2026-09-03)."""
    try:
        import sqlite_vec
        c.enable_load_extension(True)
        sqlite_vec.load(c)
        c.enable_load_extension(False)
        return True
    except Exception as e:
        print(f"vault-search: sqlite-vec unavailable ({e}); lexical only", file=sys.stderr)
        return False


def embed_workers(override=None):
    """Bounded by three things, whichever is smallest.

    Memory: ~1.4GB per worker, measured — each loads its own copy of the model.
    Use at most half of what is actually free so the machine stays usable.

    Cores: leave 6 free. This is not about throughput, it is about latency —
    saturating every core makes audio work impossible (xruns), and this box runs
    Bitwig. A job that finishes an hour sooner but makes the machine unusable
    while it runs is not faster in any sense that matters."""
    if override:
        return max(1, int(override))
    try:
        avail = int([l.split()[1] for l in open("/proc/meminfo")
                     if l.startswith("MemAvailable")][0]) * 1024
        by_mem = max(1, int(avail * 0.5 // (1.5 * 1024**3)))
    except Exception:
        by_mem = 2
    return max(1, min(EMBED_WORKERS, by_mem, (os.cpu_count() or 8) - 6))


def embed_texts(texts, workers=None):
    """`parallel` on embed() spreads work across processes and is worth ~5.5x over the
    default; `threads` on the constructor does nothing measurable. MUST be called under
    a __main__ guard — it forks, and children re-import the calling module.

    parallel=0 means one worker PER CORE, and each worker holds its own ~1.4GB model.
    That is not a throughput knob, it is a memory multiplier. Bounded here."""
    from fastembed import TextEmbedding
    model = TextEmbedding(model_name=EMBED_MODEL)
    return model.embed(texts, batch_size=32, parallel=workers or embed_workers())


def embed_cmd(args):
    import struct
    # A killed parent orphans its workers — they keep running and keep their memory.
    # Starting a second run on top of the first is what put the machine into swap.
    lock = HOME/".local/state/vault-search-embed.lock"
    if lock.exists():
        try:
            pid = int(lock.read_text().strip())
            os.kill(pid, 0)
            print(f"vault-search: embed already running (pid {pid}); refusing to start a second.\n"
                  f"  If that pid is dead, remove {lock}", file=sys.stderr)
            return 1
        except (ValueError, ProcessLookupError, PermissionError):
            lock.unlink(missing_ok=True)
    lock.parent.mkdir(parents=True, exist_ok=True)
    lock.write_text(str(os.getpid()))
    try:
        return _embed_run(args, struct)
    finally:
        lock.unlink(missing_ok=True)


def _embed_run(args, struct):
    c = connect(vec=True)
    if not load_vec(c):
        return 1
    todo = c.execute("""SELECT ch.id, d.title, ch.heading, ch.text
                        FROM chunks ch JOIN documents d ON d.id = ch.doc_id
                        WHERE ch.id NOT IN (SELECT chunk_id FROM vec_chunks)
                        ORDER BY ch.id""").fetchall()
    if args.limit:
        todo = todo[:args.limit]
    if not todo:
        print("all chunks embedded"); return 0
    print(f"{len(todo)} chunks to embed (~{len(todo)/14.4/60:.0f} min at measured throughput)")
    # Frontmatter prepended: a chunk from mid-document otherwise carries no signal
    # about whose page it is.
    w = embed_workers(getattr(args, "workers", None))
    print(f"  {w} worker(s) ≈ {w * 1.4:.0f}GB, leaving {(os.cpu_count() or 8) - w} cores free; "
          f"slices of {SLICE}", file=sys.stderr)
    t0, done = time.time(), 0
    for lo in range(0, len(todo), SLICE):
        sl = todo[lo:lo + SLICE]
        texts = [f"{t or ''}\n{h or ''}\n{x}" for _, t, h, x in sl]
        ids = [r[0] for r in sl]
        batch_ids, batch_vecs = [], []
        for i, v in enumerate(embed_texts(texts, workers=w)):
            batch_ids.append(ids[i]); batch_vecs.append(v)
            if len(batch_ids) >= 500:
                c.executemany("INSERT OR REPLACE INTO vec_chunks(chunk_id, embedding) VALUES(?,?)",
                              [(cid, struct.pack(f"{EMBED_DIM}f", *vv)) for cid, vv in zip(batch_ids, batch_vecs)])
                c.commit(); done += len(batch_ids); batch_ids, batch_vecs = [], []
                el = time.time() - t0
                print(f"  {done}/{len(todo)}  {done/el:.1f}/s  eta {(len(todo)-done)/max(done/el,0.1)/60:.0f}m", file=sys.stderr)
        if batch_ids:
            c.executemany("INSERT OR REPLACE INTO vec_chunks(chunk_id, embedding) VALUES(?,?)",
                          [(cid, struct.pack(f"{EMBED_DIM}f", *vv)) for cid, vv in zip(batch_ids, batch_vecs)])
            c.commit(); done += len(batch_ids)
    print(f"embedded {done} chunks in {(time.time()-t0)/60:.1f} min")
    return 0


def vector_ids(c, query, k=200):
    """Returns [chunk_id] ranked by cosine distance, or [] if unavailable."""
    import struct
    try:
        qv = list(embed_texts([query]))[0]
        rows = c.execute("SELECT chunk_id FROM vec_chunks WHERE embedding MATCH ? "
                         "ORDER BY distance LIMIT ?",
                         (struct.pack(f"{EMBED_DIM}f", *qv), k)).fetchall()
        return [r[0] for r in rows]
    except Exception as e:
        print(f"vault-search: vector search unavailable ({e})", file=sys.stderr)
        return []


def drop_vectors(c, doc_id):
    """A vector outlives its chunk unless explicitly removed, and SQLite reuses freed
    rowids — so without this an edited document's new text is served by the OLD text's
    embedding, while `stat` reports 100% embedded. Verified reproducible."""
    try:
        c.execute("DELETE FROM vec_chunks WHERE chunk_id IN (SELECT id FROM chunks WHERE doc_id=?)", (doc_id,))
    except sqlite3.OperationalError:
        pass          # vector table absent; nothing to clean


def index_cmd(args):
    man = load_manifest()
    c = connect(vec=True)
    existing = {r[0]: (r[1], r[2]) for r in c.execute("SELECT path, hash, id FROM documents")}
    t0 = time.time()
    seen, added, updated, chunks_n = set(), 0, 0, 0

    for p, root, tier in scan(man):
        sp = str(p); seen.add(sp)
        try:
            raw = p.read_text(errors="ignore")
        except Exception:
            continue
        # NUL bytes mean this is not text, whatever the extension says. macOS
        # AppleDouble files (._*) are markdown by name and binary by content, and
        # 473 of them were indexed as chunks of unsearchable garbage.
        if "\x00" in raw[:4096]:
            continue
        h = hashlib.sha256(raw.encode("utf-8", "ignore")).hexdigest()[:16]
        prev = existing.get(sp)
        if prev and prev[0] == h and not args.force:
            continue
        fm_raw, body, off = split_frontmatter(raw)
        fm = parse_frontmatter(fm_raw)
        title = fm.get("title") or p.stem
        if isinstance(title, list): title = title[0] if title else p.stem
        date = fm.get("date") or fm.get("published_date") or fm.get("saved_date") or ""
        if isinstance(date, list): date = date[0] if date else ""

        if prev:
            drop_vectors(c, prev[1])
            c.execute("DELETE FROM chunks WHERE doc_id=?", (prev[1],))
            c.execute("DELETE FROM meta WHERE doc_id=?", (prev[1],))
            c.execute("DELETE FROM links WHERE doc_id=?", (prev[1],))
            c.execute("UPDATE documents SET root=?,tier=?,mtime=?,hash=?,title=?,date=?,indexed_at=? WHERE id=?",
                      (str(root), tier, p.stat().st_mtime, h, str(title)[:300], str(date)[:40], time.time(), prev[1]))
            doc_id = prev[1]; updated += 1
        else:
            cur = c.execute("INSERT INTO documents(path,root,tier,mtime,hash,title,date,indexed_at) VALUES(?,?,?,?,?,?,?,?)",
                            (sp, str(root), tier, p.stat().st_mtime, h, str(title)[:300], str(date)[:40], time.time()))
            doc_id = cur.lastrowid; added += 1

        for k, v in fm.items():
            for vv in (v if isinstance(v, list) else [v]):
                if vv: c.execute("INSERT INTO meta(doc_id,key,value) VALUES(?,?,?)", (doc_id, k[:60], str(vv)[:300]))
        for t in set(LINK_RE.findall(raw)):
            c.execute("INSERT INTO links(doc_id,target) VALUES(?,?)", (doc_id, t.strip()[:200]))

        # A document whose body is empty but whose frontmatter carries a title and
        # summary is still worth finding — Reader saves a lot of these (a tweet, a
        # link with no extractable text). Index the metadata rather than nothing.
        pieces = list(chunk(body, off))
        if not pieces:
            # Vault entity pages are often pure frontmatter — type, ideology,
            # affiliation, no body. 72 were indexed with zero chunks and were
            # unfindable by their own name. Card = title plus every property value.
            vals = []
            for k, v in fm.items():
                for vv in (v if isinstance(v, list) else [v]):
                    if vv and not str(vv).startswith(("http", "![")): vals.append(f"{k}: {vv}")
            card = (str(title) + "\n" + "\n".join(vals)).strip()
            if card: pieces = [("", card, 1, 1)]
        for i, (head, txt, s, e) in enumerate(pieces):
            cur = c.execute("INSERT INTO chunks(doc_id,ord,heading,text,start_line,end_line) VALUES(?,?,?,?,?,?)",
                            (doc_id, i, head[:200], txt, s, e))
            c.execute("INSERT INTO chunks_fts(rowid,text) VALUES(?,?)", (cur.lastrowid, txt))
            chunks_n += 1
        if (added + updated) % 500 == 0:
            c.commit(); print(f"  … {added+updated} docs, {chunks_n} chunks", file=sys.stderr)

    gone = [pth for pth in existing if pth not in seen]
    for pth in gone:
        row = c.execute("SELECT id FROM documents WHERE path=?", (pth,)).fetchone()
        if row: drop_vectors(c, row[0])
        c.execute("DELETE FROM chunks WHERE doc_id=(SELECT id FROM documents WHERE path=?)", (pth,))
        c.execute("DELETE FROM documents WHERE path=?", (pth,))
    c.commit()
    c.execute("INSERT INTO chunks_fts(chunks_fts) VALUES('rebuild')"); c.commit()
    n_docs = c.execute("SELECT COUNT(*) FROM documents").fetchone()[0]
    n_chunks = c.execute("SELECT COUNT(*) FROM chunks").fetchone()[0]
    print(f"{added} new, {updated} changed, {len(gone)} removed | {n_docs} docs, {n_chunks} chunks | {time.time()-t0:.0f}s")


def fts_query(q, raw=False):
    """FTS5 treats `-`, `\'`, `:` and bare NOT/AND/OR as syntax. Ordinary journalist
    queries — far-right, O\'Brien, Mar-a-Lago — raised OperationalError. Quote every
    term as a phrase unless --raw is passed."""
    if raw: return q
    terms = [t for t in re.split(r'\s+', q.strip()) if t]
    return " ".join('"' + t.replace('"', '""') + '"' for t in terms) or '""'


def _rows(c, q, tiers, since, project, limit):
    sql = """SELECT d.path, d.tier, d.title, d.date, ch.start_line, ch.heading, ch.text,
                    bm25(chunks_fts) AS score
             FROM chunks_fts JOIN chunks ch ON ch.id = chunks_fts.rowid
             JOIN documents d ON d.id = ch.doc_id
             WHERE chunks_fts MATCH ?"""
    p = [q]
    if tiers:
        sql += f" AND d.tier IN ({','.join('?'*len(tiers))})"; p += tiers
    if since:
        sql += " AND d.date >= ?"; p.append(since)
    if project:
        sql += " AND d.id IN (SELECT doc_id FROM meta WHERE key IN ('project','tags') AND value = ?)"; p.append(project)
    sql += " ORDER BY score LIMIT ?"; p.append(limit)
    return c.execute(sql, p).fetchall()


def show(rows, as_json, sweep=False):
    if as_json:
        for r in rows:
            print(json.dumps({"path": r[0], "tier": r[1], "title": r[2], "date": r[3],
                              "line": r[4], "heading": r[5], "score": r[7],
                              "excerpt": " ".join(r[6].split())[:300]}))
        return
    if not rows:
        print("no matches"); return
    seen = set()
    for path, tier, title, date, line, heading, text, score in rows:
        if sweep and path in seen: continue
        seen.add(path)
        flag = "  ⚠ machine transcript" if tier == "transcript" else ""
        print(f"\n{path}:{line}  [{tier}]{f'  {date[:10]}' if date else ''}{flag}")
        if heading: print(f"  § {heading[:90]}")
        print(f"  {' '.join(text.split())[:260]}")


def _rows_by_ids(c, ids, tiers):
    if not ids: return []
    q = f"""SELECT ch.id, d.path, d.tier, d.title, d.date, ch.start_line, ch.heading, ch.text
            FROM chunks ch JOIN documents d ON d.id = ch.doc_id
            WHERE ch.id IN ({','.join('?'*len(ids))})"""
    p = list(ids)
    if tiers:
        q += f" AND d.tier IN ({','.join('?'*len(tiers))})"; p += tiers
    return {r[0]: r[1:] for r in c.execute(q, p)}


def find_cmd(a):
    """Lexical by default — fast, no model load. --semantic adds vector recall and
    fuses by reciprocal rank, so bm25 and cosine scales never have to be reconciled."""
    c = connect(vec=a.semantic)
    lex = _rows(c, fts_query(a.query, getattr(a, 'raw', False)), a.tier, a.since, a.project, max(a.limit * 4, 40))
    if not a.semantic:
        show(lex[:a.limit], a.json); return

    fused = {}
    for rank, r in enumerate(lex):
        fused[(r[0], r[4])] = fused.get((r[0], r[4]), 0) + 1.0 / (RRF_K + rank)
    vids = vector_ids(c, a.query, k=200)
    vrows = _rows_by_ids(c, vids, a.tier)
    order = {cid: i for i, cid in enumerate(vids)}
    for cid, row in vrows.items():
        key = (row[0], row[4])
        fused[key] = fused.get(key, 0) + 1.0 / (RRF_K + order.get(cid, 999))
    lookup = {(r[0], r[4]): r for r in lex}
    for cid, row in vrows.items():
        lookup.setdefault((row[0], row[4]), (row[0], row[1], row[2], row[3], row[4], row[5], row[6], 0.0))
    ranked = [lookup[k] for k in sorted(fused, key=lambda k: -fused[k]) if k in lookup]
    show(ranked[:a.limit], a.json)


def sweep_cmd(a):
    """Recall, not precision. Vector recall is on by default here because the
    corrections protocol exists to catch the same claim phrased differently, which
    is exactly what lexical search cannot do."""
    c = connect(vec=not a.no_semantic)
    rows = list(_rows(c, fts_query(a.query, getattr(a, 'raw', False)), a.tier, None, None, 400))
    if not a.no_semantic:
        have = {(r[0], r[4]) for r in rows}
        vrows = _rows_by_ids(c, vector_ids(c, a.query, k=300), a.tier)
        for row in vrows.values():
            if (row[0], row[4]) not in have:
                rows.append((row[0], row[1], row[2], row[3], row[4], row[5], row[6], 0.0))
    show(rows, a.json, sweep=True)
    if a.frontmatter:
        hits = c.execute("SELECT DISTINCT d.path, m.key, m.value FROM meta m JOIN documents d ON d.id=m.doc_id "
                         "WHERE m.value LIKE ? LIMIT 100", (f"%{a.query}%",)).fetchall()
        if hits:
            print("\n── frontmatter properties (assert facts silently) ──")
            for p, k, v in hits: print(f"  {p}\n    {k}: {v}")


def links_cmd(a):
    c = connect()
    rows = c.execute("SELECT d.path, d.tier FROM links l JOIN documents d ON d.id=l.doc_id "
                     "WHERE l.target LIKE ? LIMIT ?", (a.entity, a.limit)).fetchall()
    print(f"pages linking to [[{a.entity}]]: {len(rows)}")
    for p, t in rows: print(f"  [{t}] {p}")


def stat_cmd(a):
    c = connect()
    print(f"db: {DB}  ({DB.stat().st_size/1048576:.0f}MB)" if DB.exists() else "not built")
    for tier, n, ch in c.execute("""SELECT d.tier, COUNT(DISTINCT d.id), COUNT(ch.id)
                                    FROM documents d LEFT JOIN chunks ch ON ch.doc_id=d.id
                                    GROUP BY d.tier ORDER BY 3 DESC"""):
        print(f"  {tier:12} {n:6} docs  {ch:8} chunks")
    tot = c.execute("SELECT COUNT(*) FROM documents").fetchone()[0]
    tc = c.execute("SELECT COUNT(*) FROM chunks").fetchone()[0]
    print(f"  {'TOTAL':12} {tot:6} docs  {tc:8} chunks")
    if load_vec(c):
        try:
            ev = c.execute("SELECT COUNT(*) FROM vec_chunks").fetchone()[0]
            print(f"  embedded: {ev}/{tc} chunks ({100*ev/max(tc,1):.0f}%)"
                  + ("" if ev >= tc else f" — `vault-search embed` for the remaining {tc-ev}"))
        except Exception:
            print("  embedded: 0 chunks — run `vault-search embed`")
        try:
            orph = c.execute("SELECT COUNT(*) FROM vec_chunks v WHERE NOT EXISTS"
                             "(SELECT 1 FROM chunks c WHERE c.id = v.chunk_id)").fetchone()[0]
            print(f"  orphaned vectors: {orph}" + ("" if orph == 0 else "  ← STALE, reindex and re-embed"))
        except Exception:
            pass


def main():
    ap = argparse.ArgumentParser(prog="vault-search")
    sub = ap.add_subparsers(dest="cmd", required=True)
    i = sub.add_parser("index"); i.add_argument("--force", action="store_true"); i.set_defaults(fn=index_cmd)
    f = sub.add_parser("find"); f.add_argument("query"); f.add_argument("--tier", action="append")
    f.add_argument("--since"); f.add_argument("--project"); f.add_argument("--limit", type=int, default=10)
    f.add_argument("--json", action="store_true")
    f.add_argument("--semantic", action="store_true", help="add vector recall (loads the model, ~5s)")
    f.add_argument("--raw", action="store_true", help="pass the query to FTS5 verbatim (AND/OR/NEAR syntax)")
    f.set_defaults(fn=find_cmd)
    s = sub.add_parser("sweep"); s.add_argument("query"); s.add_argument("--tier", action="append")
    s.add_argument("--frontmatter", action="store_true"); s.add_argument("--json", action="store_true")
    s.add_argument("--no-semantic", action="store_true", help="lexical only, skip the model load")
    s.add_argument("--raw", action="store_true", help="pass the query to FTS5 verbatim")
    s.set_defaults(fn=sweep_cmd)
    l = sub.add_parser("links"); l.add_argument("entity"); l.add_argument("--limit", type=int, default=50)
    l.set_defaults(fn=links_cmd)
    e = sub.add_parser("embed", help="compute missing chunk embeddings (resumable)")
    e.add_argument("--limit", type=int, default=0, help="stop after N chunks; resumable, so safe to run in slices")
    e.add_argument("--workers", type=int, default=0, help="override worker count (default: sized against free memory and cores)")
    e.set_defaults(fn=embed_cmd)
    st = sub.add_parser("stat"); st.set_defaults(fn=stat_cmd)
    a = ap.parse_args(); return a.fn(a) or 0


if __name__ == "__main__":
    sys.exit(main())
