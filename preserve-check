#!/usr/bin/env python3
"""preserve-check — which sources in a draft have never been archived.

The inversion of logging your browsing. Rather than recording every page you look at
— poor signal, invasive, and the useful subset is already captured by Reader saves and
clips — this asks the question that actually matters: of the URLs a piece RESTS ON,
which would vanish if the site took them down?

Read-only by default. Saving a page to the Wayback Machine publishes that URL to a
third party, which for pre-publication reporting can signal what you are working on
and to whom — so --save is opt-in, never automatic.

Usage:
    preserve-check draft.md [...]        which cited URLs have no capture
    preserve-check --story <dir>         every markdown file in a story folder
    preserve-check --save draft.md       archive the gaps (publishes to archive.org)
"""
import re, sys, json, time, pathlib, argparse, urllib.parse, urllib.request

URL_RE = re.compile(r'https?://[^\s<>()\[\]"\'`]+')
AVAIL = "https://archive.org/wayback/available?url="
SAVE = "https://web.archive.org/save/"
# Hosts where a capture is meaningless or unwanted.
SKIP = re.compile(r'''^https?://(
    localhost|127\.0\.0\.1|archive\.org|web\.archive\.org
  | (www\.)?google\.com/(search|maps)
  | mail\.|read\.readwise\.io
)''', re.X | re.I)


def urls_in(path):
    try:
        t = pathlib.Path(path).read_text(errors="ignore")
    except Exception:
        return []
    out, seen = [], set()
    for m in URL_RE.finditer(t):
        u = m.group(0).rstrip('.,;:)"\'')
        if SKIP.match(u) or u in seen:
            continue
        seen.add(u)
        line = t[:m.start()].count("\n") + 1
        out.append((line, u))
    return out


def archived(u, timeout=20):
    """(has_capture, timestamp_or_None). None,None on a network error — an error is
    NOT evidence of absence, and reporting it as a gap would send you to re-archive
    things that are already fine."""
    try:
        req = urllib.request.Request(AVAIL + urllib.parse.quote(u, safe=""),
                                     headers={"User-Agent": "preserve-check/1.0"})
        with urllib.request.urlopen(req, timeout=timeout) as r:
            d = json.loads(r.read().decode("utf-8", "replace"))
        snap = (d.get("archived_snapshots") or {}).get("closest") or {}
        return (bool(snap.get("available")), snap.get("timestamp"))
    except Exception:
        return (None, None)


def save(u, timeout=60):
    try:
        req = urllib.request.Request(SAVE + u, headers={"User-Agent": "preserve-check/1.0"})
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return r.status in (200, 302)
    except Exception as e:
        print(f"      save failed: {type(e).__name__}", file=sys.stderr)
        return False


def main():
    ap = argparse.ArgumentParser(prog="preserve-check")
    ap.add_argument("files", nargs="*")
    ap.add_argument("--story", help="check every .md under a story directory")
    ap.add_argument("--save", action="store_true",
                    help="archive the gaps — PUBLISHES each URL to archive.org")
    ap.add_argument("--delay", type=float, default=1.0)
    a = ap.parse_args()

    targets = list(a.files)
    if a.story:
        targets += [str(p) for p in sorted(pathlib.Path(a.story).rglob("*.md"))]
    if not targets:
        print("usage: preserve-check draft.md | --story <dir>", file=sys.stderr)
        return 2

    found = {}
    for f in targets:
        for line, u in urls_in(f):
            found.setdefault(u, (f, line))
    if not found:
        print("no external URLs found")
        return 0

    print(f"{len(found)} distinct URL(s) across {len(targets)} file(s)\n")
    gaps, errors, ok = [], [], 0
    for i, (u, (f, line)) in enumerate(sorted(found.items()), 1):
        has, ts = archived(u)
        if has is None:
            errors.append((u, f, line))
        elif has:
            ok += 1
        else:
            gaps.append((u, f, line))
        if i < len(found):
            time.sleep(a.delay)

    print(f"  archived      {ok}")
    print(f"  NOT archived  {len(gaps)}")
    if errors:
        print(f"  check failed  {len(errors)}  (network error — not evidence of absence)")
    for u, f, line in gaps:
        print(f"\n  {pathlib.Path(f).name}:{line}\n    {u}")
    if gaps and a.save:
        print(f"\narchiving {len(gaps)} URL(s) — this publishes them to archive.org")
        for u, _, _ in gaps:
            print(f"  {'saved' if save(u) else 'FAILED'}  {u[:90]}")
            time.sleep(a.delay)
    elif gaps:
        print(f"\n  Re-run with --save to archive these. That publishes each URL to a\n"
              f"  third party, so consider whether the story is sensitive first.")
    return 1 if gaps else 0


if __name__ == "__main__":
    sys.exit(main())
