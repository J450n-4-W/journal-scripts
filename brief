#!/usr/bin/env python3
"""brief — six-slot morning brief appended to the daily note at 06:00.

The binding constraint is being read, not being complete: daily-session-log wrote
handoff-quality logs for months that went unread. So slots are capped at one line,
empty slots yield rather than pad, and items that keep surfacing without being acted
on age out and get reported.

Spec and reasoning: ~/notebook/pages/brief.md

Usage:
    brief                write the block into today's daily note
    brief --dry-run      print the block, write nothing
    brief --show         print slots without touching state
    brief dismiss KEY    silence an item for the cooldown period
    brief --rollup       weekly aged-out report
"""
import os, re, sys, json, pathlib, datetime, subprocess

HOME = pathlib.Path.home()
JOURNALS = HOME/"notebook/journals"
STAGING = HOME/"notebook-staging"
LIFE = HOME/"notebook/life"
STATE = HOME/".local/state/brief-state.json"
LOGFILE = HOME/".local/state/brief.log"
INVEST = (HOME/"Investigations").resolve()

# Provisional — guessed, not derived. Replace by observing real data.
SLIPPING_DAYS = 10
COOLDOWN_DAYS = 21
AGE_OUT_AFTER = 5

BEGIN, END = "<!-- brief:begin -->", "<!-- brief:end -->"
TODAY = datetime.date.today()


def log(msg):
    LOGFILE.parent.mkdir(parents=True, exist_ok=True)
    with open(LOGFILE, "a") as f:
        f.write(f"[{datetime.datetime.now():%Y-%m-%d %H:%M:%S}] {msg}\n")


def load_state():
    if STATE.is_file():
        try: return json.loads(STATE.read_text())
        except Exception: pass
    return {"surfaced": {}, "dismissed": {}, "aged_out": []}


def save_state(s):
    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text(json.dumps(s, indent=1, sort_keys=True))


def projects_records():
    """Reuse the projects tool rather than reimplementing its status logic."""
    # Resolve the SAME binary the maintenance slot shells out to. Importing from a
    # hard-coded dev path while also invoking `projects` from $PATH gave two copies
    # that could silently diverge if one was edited without installing.
    import shutil
    found = shutil.which("projects")
    src = pathlib.Path(found).resolve() if found else HOME/"Software_Development_Projects/journal-scripts/projects"
    if not src.is_file():
        log("projects binary not found; slots 1-4 unavailable")
        return [], []
    import importlib.util, importlib.machinery
    l = importlib.machinery.SourceFileLoader("pj", str(src))
    pj = importlib.util.module_from_spec(importlib.util.spec_from_loader("pj", l))
    l.exec_module(pj)
    idx = pj.build_log_index()
    recs = [r.compute(idx) for r in pj.load_records()]
    return recs, pj.find_gaps(recs)


def sh(cmd):
    """Returns (stdout, returncode). A missing binary, a crash or a timeout returns
    rc=-1 — NOT rc=0 with empty output, which is what "the command ran and found
    nothing" looks like. Conflating those is how a broken maintenance check reads as
    a clean one, which is the failure this whole tool exists to surface elsewhere."""
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
        return r.stdout.strip(), r.returncode
    except Exception as e:
        log(f"subprocess failed: {' '.join(cmd)}: {type(e).__name__}: {e}")
        return "", -1


def candidates(state=None):
    """[(slot, key, line)] — at most one per slot, already filtered and ranked.

    `state` filters dismissed and aged-out items BEFORE each slot picks its top
    candidate. Picking first and filtering afterwards left the slot empty for good
    once its leader aged out: the second-slipping project was never reachable."""
    state = state or {"dismissed": {}, "surfaced": {}}

    def alive(key):
        d = state.get("dismissed", {}).get(key)
        if d and datetime.date.fromisoformat(d) > TODAY:
            return False
        return state.get("surfaced", {}).get(key, {}).get("count", 0) < AGE_OUT_AFTER

    out = []
    recs, gaps = projects_records()
    live = [r for r in recs if r.derived_status == "research" and r.last_activity]
    live.sort(key=lambda r: r.last_activity, reverse=True)

    live = [r for r in live if alive(f"project:{r.name}")]
    for r in live[:2]:
        n = r.outstanding()
        out.append(("open", f"project:{r.name}",
                    f"**{r.name}** — active, {r.days_quiet}d since last activity"
                    + (f", {n} outstanding" if n else "")))

    slipping = [r for r in recs
                if r.derived_status != "published" and r.outstanding() > 0
                and (r.days_quiet or 0) >= SLIPPING_DAYS]
    slipping = [r for r in slipping if alive(f"slip:{r.name}")]
    slipping.sort(key=lambda r: r.days_quiet or 0, reverse=True)
    if slipping:
        r = slipping[0]
        out.append(("slipping", f"slip:{r.name}",
                    f"**{r.name}** slipping — quiet {r.days_quiet}d with {r.outstanding()} outstanding"))

    aband = [(f"gap:{d.name}", f"**{d.relative_to(INVEST)}** — {w} files, no story page", w)
             for d, w in gaps]
    aband += [(f"shelved:{r.name}", f"**{r.name}** — shelved, quiet {r.days_quiet}d", 0)
              for r in recs if r.derived_status == "shelved"]
    aband = [a for a in aband if alive(a[0])]
    aband.sort(key=lambda x: -x[2])
    if aband:
        out.append(("abandoned", aband[0][0], aband[0][1]))

    maint, broken = [], []
    hs, rc = sh(["hub-sync", "--check"])
    if rc == -1: broken.append("hub-sync")
    if rc == 1:
        first = [l for l in hs.splitlines() if not l.endswith("0 unfiled") and "clean" not in l]
        if first: maint.append(first[0].strip())
    pc, rc = sh(["projects", "check"])
    if rc == -1: broken.append("projects")
    if rc == 1:
        stale = [l for l in pc.splitlines() if l.startswith(("stale status", "no story_dir"))]
        if stale: maint.append(f"{len(stale)} project record(s) need attention")
    patches = len(list((STAGING/"digest/patches").glob("*"))) if (STAGING/"digest/patches").is_dir() else 0
    if patches: maint.append(f"{patches} staged vault-digest patch(es) awaiting review")
    stubs = len(list((STAGING/"stubs").glob("*.md"))) if (STAGING/"stubs").is_dir() else 0
    if stubs: maint.append(f"{stubs} drafted stub(s) awaiting review")
    if broken:
        # Stable key: keyed on which check broke, not on its (changing) message text.
        out.append(("maintenance", "maint:broken:" + ",".join(sorted(broken)),
                    f"⚠ maintenance check failed to run: {', '.join(broken)} — see ~/.local/state/brief.log"))
    elif maint:
        # Key on the KIND of item, not the text: "3 staged patches" -> "4 staged
        # patches" used to change the key, reset the surfaced count, and prevent
        # the item ever ageing out.
        kind = re.sub(r'\d+', 'N', maint[0])[:60]
        out.append(("maintenance", "maint:" + kind, "; ".join(maint[:2])))

    if LIFE.is_dir():
        items = [f for f in sorted(LIFE.glob("*.md")) if alive(f"life:{f.stem}")]
        if items:
            oldest = min(items, key=lambda p: p.stat().st_mtime)
            out.append(("life", f"life:{oldest.stem}", f"**{oldest.stem}**"))
    return out


def render(state, record=True, cands=None):
    cands = candidates() if cands is None else cands
    lines, surfaced = [], []
    for slot, key, text in cands:
        d = state["dismissed"].get(key)
        if d and datetime.date.fromisoformat(d) > TODAY:
            continue
        seen = state["surfaced"].get(key, {"count": 0})
        if seen["count"] >= AGE_OUT_AFTER:
            continue                      # aged out; already reported in a rollup
        lines.append(f"- {text}")
        surfaced.append(key)
    if record:
        for key in surfaced:
            e = state["surfaced"].setdefault(key, {"count": 0, "first": TODAY.isoformat()})
            # Count mornings surfaced, not times run. Re-running by hand must not
            # age an item out early.
            if e.get("last") == TODAY.isoformat():
                continue
            e["count"] += 1
            e["last"] = TODAY.isoformat()
            if e["count"] == AGE_OUT_AFTER:
                state["aged_out"].append({"key": key, "on": TODAY.isoformat()})
        # An item that stopped being a candidate has cleared — forget it, so a
        # recurrence starts a fresh count rather than ageing out immediately.
        live = {k for _, k, _ in candidates()}   # unfiltered: what is *actually* a
                                                 # candidate, not what survived state
        # Clear ANY item that has left the candidate set, aged-out included. Keeping
        # aged-out entries forever meant a condition that recurred months later was
        # silently suppressed, despite the comment claiming a fresh count.
        for k in list(state["surfaced"]):
            if k not in live:
                del state["surfaced"][k]
    return lines, surfaced


# (label, newest-mtime source, expected cadence in hours). A job whose artefact is
# older than 2x its cadence is stale; one with no artefact at all has never run.
HEALTH = [
    ("session-log",  HOME/".local/state/daily-session-log.log",        24),
    ("brief",        HOME/".local/state/brief.log",                    24),
    ("index",        HOME/".local/state/vault-search.db",              24 * 7),
    ("ct-watch",     HOME/"Investigations/old_stories/NDA/evidence/crtsh/watch", 12),
    ("fara-watch",   HOME/"notebook/fara-watch",                       24),
    ("congress-watch", HOME/"notebook/congress-watch",                 24),
    ("donor-watch",  HOME/"notebook/donor-watch",                      24 * 7),
    ("gift-travel",  HOME/"notebook/gift-travel-watch",                24 * 7),
    ("backup",       pathlib.Path("/mnt/4tb-external/home-backup/snapshots"), 24 * 8),
]


def health_line():
    """The ten-week dead cron job, the unread session logs and a maintenance check
    that failed silently are the same failure: automation that stops without saying
    so. This puts every job's liveness into the one artefact that gets read daily."""
    import time
    now, parts, stale = time.time(), [], False
    for label, path, cadence in HEALTH:
        try:
            if path.is_dir():
                ts = max((f.stat().st_mtime for f in path.iterdir()), default=0)
            else:
                ts = path.stat().st_mtime
        except Exception:
            ts = 0
        if not ts:
            # An external drive that is simply unplugged is not a dead job. Saying
            # so avoids a standing false alarm, which is how a health line gets
            # ignored — the exact failure it exists to prevent.
            if not path.parent.exists():
                parts.append(f"{label} n/a"); continue
            parts.append(f"{label} never"); stale = True; continue
        age_h = (now - ts) / 3600
        if age_h > cadence * 2:
            parts.append(f"**{label} {int(age_h // 24)}d**" if age_h >= 24 else f"**{label} {int(age_h)}h**")
            stale = True
        else:
            parts.append(f"{label} {int(age_h // 24)}d" if age_h >= 24 else f"{label} {int(age_h)}h")
    mark = "⚠ " if stale else ""
    return f"_{mark}health: " + " · ".join(parts) + "_"


def block(lines):
    body = "\n".join(lines) if lines else "_Nothing to raise._"
    if TODAY.weekday() == 0:
        st = load_state()
        recent = [a for a in st.get("aged_out", [])
                  if (TODAY - datetime.date.fromisoformat(a["on"])).days <= 7]
        if recent:
            body += f"\n- _{len(recent)} item(s) aged out unactioned this week: " \
                    + ", ".join(a["key"] for a in recent) + "_"
    return f"{BEGIN}\n\n## Morning brief\n\n{body}\n\n{health_line()}\n\n{END}"


def write_note(text):
    JOURNALS.mkdir(parents=True, exist_ok=True)
    note = JOURNALS/f"{TODAY.strftime('%Y_%m_%d')}.md"
    cur = note.read_text() if note.is_file() else ""
    i, j = cur.find(BEGIN), cur.find(END)
    if i != -1 and j != -1:
        new = cur[:i] + text + cur[j+len(END):]
    else:
        new = (cur.rstrip("\n") + "\n\n" if cur.strip() else "") + text + "\n"
    if new != cur:
        note.write_text(new); return note, True
    return note, False


def main():
    args = sys.argv[1:]
    if args and args[0] == "dismiss":
        if len(args) < 2: print("brief dismiss KEY", file=sys.stderr); return 2
        s = load_state()
        s["dismissed"][args[1]] = (TODAY + datetime.timedelta(days=COOLDOWN_DAYS)).isoformat()
        save_state(s); print(f"dismissed {args[1]} until {s['dismissed'][args[1]]}"); return 0
    if "--rollup" in args:
        s = load_state()
        if not s.get("aged_out"): print("nothing has aged out"); return 0
        for a in s["aged_out"][-20:]: print(f"{a['on']}  {a['key']}")
        return 0
    if "--show" in args or "--dry-run" in args:
        lines, _ = render(load_state(), record=False)
        print(block(lines)); return 0
    s = load_state()
    lines, surfaced = render(s, record=True)
    note, changed = write_note(block(lines))
    save_state(s)
    print(f"{len(lines)} slot(s) filled, {'wrote' if changed else 'no change to'} {note.name}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
