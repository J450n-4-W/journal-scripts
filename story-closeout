#!/usr/bin/env bash
# story-closeout — archive a Guardian story folder into the PKM vault and media archive
#
# Usage: story-closeout <story-directory> [--slug NAME] [--date YYYY_MM] [--dry-run]
#
# Text files   → ~/notebook/archive/          (flat, tagged by frontmatter)
# Small docs   → ~/notebook/assets/<slug>/    (PDFs, EPUBs, DOCXs, CSVs, JSONs, DBs, ZIPs)
# Large media  → $MEDIA_ARCHIVE/<date_slug>/  (video, audio — MOVED, not copied)
# Working .md  → listed for review (fold into entity pages)
#
# Does NOT modify text source files — copies to vault.
# DOES move media files (video/audio) to free NVMe space.
#
# Anything the script decides NOT to take is printed, never dropped silently:
# .txt files that don't look like transcripts, and subdirectories holding .md
# that didn't match a clip-directory name. Read those lists — they are where
# real material hides. Use --dry-run first on an unfamiliar folder.

set -euo pipefail

VAULT="$HOME/notebook"
ARCHIVE="$VAULT/archive"
ASSETS="$VAULT/assets"
# Resolve the external SSD by LABEL so a shifted mountpoint (…/4tb-external vs
# …/4tb-external1, e.g. when a stale mountpoint dir shadows the clean name) can't
# misdirect the move to the wrong (possibly root-owned) path.
EXT_MOUNT="$(findmnt -rno TARGET LABEL=4tb-external 2>/dev/null | head -1)"
MEDIA_ARCHIVE="${EXT_MOUNT:-/media/jason/4tb-external1}/Reporting_Media_Archive"

usage() {
    echo "Usage: story-closeout <story-directory> [--slug NAME] [--date YYYY_MM] [--dry-run]"
    echo ""
    echo "  <story-directory>  Path to the Guardian story folder"
    echo "  --slug NAME        Override the directory name for archive/assets subfolders"
    echo "  --date YYYY_MM     Reporting date prefix for media archive (e.g. 2026_03)"
    echo "                     Defaults to current year_month"
    echo "  --dry-run, -n      Print every copy/move that would happen, change nothing"
    echo ""
    echo "Example: story-closeout ~/Investigations/old_stories/Schwemmer --date 2026_03"
    exit 1
}

[[ $# -lt 1 ]] && usage

STORY_DIR="$1"
shift

SLUG=""
DATE_PREFIX=""
DRY_RUN=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --slug) SLUG="$2"; shift 2 ;;
        --date) DATE_PREFIX="$2"; shift 2 ;;
        --dry-run|-n) DRY_RUN=1; shift ;;
        *) echo "Unknown option: $1"; usage ;;
    esac
done

if [[ ! -d "$STORY_DIR" ]]; then
    echo "Error: '$STORY_DIR' is not a directory"
    exit 1
fi

STORY_DIR="$(realpath "$STORY_DIR")"
[[ -z "$SLUG" ]] && SLUG="$(basename "$STORY_DIR")"
[[ -z "$DATE_PREFIX" ]] && DATE_PREFIX="$(date +%Y_%m)"

MEDIA_DEST="$MEDIA_ARCHIVE/${DATE_PREFIX}_${SLUG}"

echo "Story closeout: $STORY_DIR"
[[ $DRY_RUN -eq 1 ]] && echo "*** DRY RUN — nothing will be copied, moved or created ***"
echo "Slug: $SLUG"
echo "Vault: $VAULT"
echo "  Archive (text):  $ARCHIVE"
echo "  Assets (docs):   $ASSETS/$SLUG/"
echo "  Media (video/audio): $MEDIA_DEST/"
echo "---"

# Dry-run-aware filesystem wrappers. Every write in this script goes through one
# of these, so --dry-run is total rather than best-effort.
do_mkdir() { [[ $DRY_RUN -eq 1 ]] || mkdir -p "$1"; }
do_cp()    { if [[ $DRY_RUN -eq 1 ]]; then echo "  would copy: $(basename "$1")"; else cp "$1" "$2"; fi; }
do_mv()    { if [[ $DRY_RUN -eq 1 ]]; then echo "  would MOVE: $(basename "$1")"; else mv "$1" "$2"; fi; }

do_mkdir "$ARCHIVE"

# Counters
copied_published=0
copied_transcripts=0
copied_clips=0
copied_ror=0
copied_assets=0
moved_media=0

# Things deliberately not taken — reported at the end so nothing vanishes quietly
skipped_txt=()
unmatched_md_dirs=()

# Helper: check basename collision.
# In dry-run nothing actually lands, so also remember what this run has already
# claimed — otherwise a name appearing twice in the tree (ror/files (1)/ and
# ror/extracted/ hold the same 12 letters) is reported as two copies when the
# real run would take one and skip the other.
declare -A planned_dests=()
check_collision() {
    local basename="$1"
    local dest_dir="${2:-$ARCHIVE}"
    if [[ $DRY_RUN -eq 1 && -n "${planned_dests["$dest_dir/$basename"]:-}" ]]; then
        echo "  WARNING: already taken earlier in this run — skipping $basename"
        return 1
    fi
    if [[ -f "$dest_dir/$basename" ]]; then
        echo "  WARNING: file already exists — skipping $basename"
        return 1
    fi
    local existing
    existing="$(find "$VAULT/pages" -maxdepth 1 -name "$basename" 2>/dev/null || true)"
    if [[ -n "$existing" ]]; then
        echo "  WARNING: basename collision with pages/ — skipping $basename"
        return 1
    fi
    [[ $DRY_RUN -eq 1 ]] && planned_dests["$dest_dir/$basename"]=1
    return 0
}

# ============================================================
# TEXT FILES → archive/ (flat)
# ============================================================

# --- Published article ---
# Filename alone is not enough: web-clipper names come from the page <title>, and
# a Guardian <title> is "<headline> | <tag> | The Guardian" only some of the time
# (rededicate-250's ends "... | Trump administration"). So also accept any
# top-level .md whose FRONTMATTER source/url points at theguardian.com. Checking
# the frontmatter rather than the body matters — drafts quote Guardian links in
# their prose and would otherwise match.
has_guardian_frontmatter() {
    awk '
        NR==1 && $0!="---" { exit 1 }
        NR>1 && $0=="---"  { exit 1 }
        NR>1 && /^(source|url):[[:space:]]*"?https?:\/\/(www\.)?theguardian\.com\// { exit 0 }
        NR>200 { exit 1 }
    ' "$1"
}

published_files="$(
    {
        find "$STORY_DIR" -maxdepth 1 -iname '*guardian*.md' -type f
        while IFS= read -r f; do
            has_guardian_frontmatter "$f" && printf '%s\n' "$f"
        done < <(find "$STORY_DIR" -maxdepth 1 -name '*.md' -type f)
    } | sort -u || true
)"
if [[ -n "$published_files" ]]; then
    while IFS= read -r f; do
        dest_name="$(basename "$f")"
        if check_collision "$dest_name"; then
            do_cp "$f" "$ARCHIVE/$dest_name"
            copied_published=$((copied_published + 1))
        fi
    done <<< "$published_files"
    echo "Published: copied $copied_published file(s)"
else
    echo "Published: NOT FOUND"
    echo "  ⚠ Download the published article to $STORY_DIR before continuing."
fi

# --- Transcripts ---
# A blanket recursive *.txt sweep is wrong: story folders also hold directory
# listings, FOIA email dumps and scratch notes as .txt, and those land in flat
# archive/ looking like interviews. Require positive evidence that a .txt IS a
# transcript — the name says so, or a sibling with the same basename is the
# media/subtitle/timestamped output it was produced from. Everything rejected is
# listed at the end for manual review.
looks_like_transcript() {
    local f="$1"
    local dir stem
    dir="$(dirname "$f")"
    stem="$(basename "$f" .txt)"

    # Named as one — covers *.transcript.txt and anything with "transcript" in it
    shopt -s nocasematch
    if [[ "$stem" == *transcript* ]]; then shopt -u nocasematch; return 0; fi
    shopt -u nocasematch

    # Produced alongside its own subtitle or timestamped output
    [[ -f "$dir/$stem.srt" || -f "$dir/$stem-timestamped.txt" ]] && return 0

    # Produced from a media file of the same name. Check the media archive too,
    # so a re-run after the media has been moved still recognises it.
    local ext
    for ext in mp3 mp4 webm m4a mkv wav flac; do
        [[ -f "$dir/$stem.$ext" ]] && return 0
        [[ -f "$MEDIA_DEST/$stem.$ext" ]] && return 0
    done
    return 1
}

txt_candidates="$(find "$STORY_DIR" -name '*.txt' ! -name '*-timestamped.txt' -type f || true)"
if [[ -n "$txt_candidates" ]]; then
    while IFS= read -r f; do
        if ! looks_like_transcript "$f"; then
            skipped_txt+=("${f#"$STORY_DIR"/}")
            continue
        fi
        dest_name="$(basename "$f" .txt).md"
        if check_collision "$dest_name"; then
            do_cp "$f" "$ARCHIVE/$dest_name"
            copied_transcripts=$((copied_transcripts + 1))
        fi
    done <<< "$txt_candidates"
    echo "Transcripts: copied $copied_transcripts (${#skipped_txt[@]} .txt skipped as non-transcript)"
else
    echo "Transcripts: none found"
fi

# --- Background / Coverage / Books clips ---
# Match clip directories by NAME PATTERN, not by two hardcoded literals. Real
# folders use rogers-coverage/, previous-coverage/, coverage/, Books/ — all of
# which the old exact-match test walked straight past.
copy_clip_dir() {
    local src_dir="$1"
    local label="$2"
    local count=0
    while IFS= read -r f; do
        dest_name="$(basename "$f")"
        if check_collision "$dest_name"; then
            do_cp "$f" "$ARCHIVE/$dest_name"
            count=$((count + 1))
        fi
    done < <(find "$src_dir" -name '*.md' -type f)
    copied_clips=$((copied_clips + count))
    echo "$label: copied $count"
}

is_clip_dir() {
    local n="${1,,}"
    [[ "$n" == *coverage* || "$n" == *background* || "$n" == *clip* || "$n" == books ]]
}

# A directory whose .md files are all RoR letters is already fully handled by the
# recursive RoR pass below — don't report it as unhandled.
all_md_are_ror() {
    local d="$1" f base
    while IFS= read -r f; do
        base="$(basename "$f")"
        shopt -s nocasematch
        if [[ "$base" != ror*.md && "$base" != *_ror.md && "$base" != *-ror.md ]]; then
            shopt -u nocasematch; return 1
        fi
        shopt -u nocasematch
    done < <(find "$d" -name '*.md' -type f)
    return 0
}

clip_dirs_found=0
while IFS= read -r d; do
    [[ -z "$d" ]] && continue
    rel="${d#"$STORY_DIR"/}"
    if is_clip_dir "$(basename "$d")"; then
        copy_clip_dir "$d" "$rel/"
        clip_dirs_found=$((clip_dirs_found + 1))
    elif ! all_md_are_ror "$d"; then
        unmatched_md_dirs+=("$rel")
    fi
done < <(find "$STORY_DIR" -mindepth 1 -type d -exec sh -c 'ls "$1"/*.md >/dev/null 2>&1' _ {} \; -print 2>/dev/null | sort || true)

[[ $clip_dirs_found -eq 0 ]] && echo "Clip directories: none matched (*coverage*, *background*, *clip*, books)"

# --- RoR files ---
# Recursive, not maxdepth 1: ror/ subdirectories are the norm (Israel_Trips,
# rededicate-250 both hold dozens there). Case-insensitive and hyphen-tolerant so
# rogers-ror.md matches as well as Beck_ROR.md and RORHegseth.md.
ror_files="$(find "$STORY_DIR" \( -iname 'ror*.md' -o -iname '*_ror.md' -o -iname '*-ror.md' \) -type f || true)"
if [[ -n "$ror_files" ]]; then
    while IFS= read -r f; do
        dest_name="$(basename "$f")"
        if check_collision "$dest_name"; then
            do_cp "$f" "$ARCHIVE/$dest_name"
            copied_ror=$((copied_ror + 1))
        fi
    done <<< "$ror_files"
    echo "RoR files: copied $copied_ror"
else
    echo "RoR files: none found"
fi

# ============================================================
# SMALL DOCUMENTS → assets/<slug>/
# ============================================================

doc_files="$(find "$STORY_DIR" \( \
    -name '*.pdf' -o -name '*.epub' -o -name '*.docx' \
    -o -name '*.csv' -o -name '*.json' -o -name '*.db' \
    -o -name '*.zip' -o -name '*.ZIP' \
    \) -type f || true)"

if [[ -n "$doc_files" ]]; then
    do_mkdir "$ASSETS/$SLUG"
    while IFS= read -r f; do
        dest_name="$(basename "$f")"
        if [[ ! -f "$ASSETS/$SLUG/$dest_name" ]]; then
            do_cp "$f" "$ASSETS/$SLUG/$dest_name"
            copied_assets=$((copied_assets + 1))
        else
            echo "  WARNING: already exists in assets — skipping $dest_name"
        fi
    done <<< "$doc_files"
    echo "Assets (docs): copied $copied_assets → $ASSETS/$SLUG/"
else
    echo "Assets (docs): none found"
fi

# ============================================================
# LARGE MEDIA → Reporting_Media_Archive (MOVED)
# ============================================================

MEDIA_MOVED=0
media_files="$(find "$STORY_DIR" \( \
    -name '*.webm' -o -name '*.mkv' -o -name '*.mp4' \
    -o -name '*.mp3' -o -name '*.m4a' \
    \) -type f || true)"

if [[ -n "$media_files" ]]; then
    if [[ -z "$EXT_MOUNT" || ! -w "$EXT_MOUNT" ]]; then
        echo "Media: ⚠ external SSD (LABEL=4tb-external) not mounted/writable — SKIPPING media move"
        echo "  Run again when the drive is mounted, or move manually to $MEDIA_DEST/"
    else
        do_mkdir "$MEDIA_DEST"
        while IFS= read -r f; do
            dest_name="$(basename "$f")"
            if [[ ! -f "$MEDIA_DEST/$dest_name" ]]; then
                do_mv "$f" "$MEDIA_DEST/$dest_name"
                moved_media=$((moved_media + 1))
            else
                echo "  WARNING: already exists in media archive — skipping $dest_name"
            fi
        done <<< "$media_files"
        echo "Media: moved $moved_media file(s) → $MEDIA_DEST/"
        MEDIA_MOVED=1
    fi
else
    echo "Media: none found"
fi

# ============================================================
# REDUNDANT FILES (skipped)
# ============================================================

skipped="$(find "$STORY_DIR" \( \
    -name '*.srt' -o -name '*-timestamped.txt' -o -name '*.py' \
    \) -type f | wc -l)"

# Working .md files — exclusions must mirror what was already taken above, or a
# file copied as an RoR or as the published article gets listed again here as an
# unhandled working note.
working_files="$(
    find "$STORY_DIR" -maxdepth 1 -name '*.md' -type f \
        ! -iname 'ror*.md' ! -iname '*_ror.md' ! -iname '*-ror.md' \
        ! -iname '*guardian*.md' \
    | { if [[ -n "$published_files" ]]; then grep -vxF -f <(printf '%s\n' "$published_files"); else cat; fi; } \
    || true
)"

# ============================================================
# SUMMARY
# ============================================================

echo "---"
total_text=$((copied_published + copied_transcripts + copied_clips + copied_ror))
echo "Text → archive/:     $total_text files"
echo "Docs → assets/:      $copied_assets files"
echo "Media → SSD:         $moved_media files (moved)"
echo "Skipped (srt/ts/py): $skipped files"
echo ""

if [[ -n "$working_files" ]]; then
    echo "Working .md files (review — fold into entity pages, don't copy as-is):"
    while IFS= read -r f; do
        echo "  $(basename "$f")"
    done <<< "$working_files"
    echo ""
fi

if [[ ${#unmatched_md_dirs[@]} -gt 0 ]]; then
    echo "Subdirectories holding .md that were NOT treated as clips (check these —"
    echo "rename to *coverage*/*background*/*clip*/books and re-run if they are):"
    for d in "${unmatched_md_dirs[@]}"; do echo "  $d/"; done
    echo ""
fi

if [[ ${#skipped_txt[@]} -gt 0 ]]; then
    echo ".txt files skipped as non-transcript (no media/srt sibling, name doesn't say"
    echo "transcript). If one of these IS an interview, copy it to $ARCHIVE by hand:"
    for f in "${skipped_txt[@]}"; do echo "  $f"; done
    echo ""
fi

# --- story page: mark published, record where the media went ---
# Matched on resolved story_dir, never on page title: frontmatter slugs and on-disk
# directory names diverge freely (Jace_Yarbrough vs yarbrough, aief-trips vs
# Israel_Trips). Only `status` and `media_archive` are written; `projects` owns
# `last_activity`, everything else is hand-maintained.
STORY_PAGE="$(STORY_DIR="$STORY_DIR" VAULT="$VAULT" python3 - <<'PYFIND'
import os, re, pathlib
target = pathlib.Path(os.environ["STORY_DIR"]).resolve()
for f in sorted((pathlib.Path(os.environ["VAULT"])/"pages").glob("*.md")):
    try: t = f.read_text(errors="ignore")
    except Exception: continue
    m = re.match(r'^---\s*\n(.*?)\n---', t, re.S)
    if not m: continue
    d = re.search(r'^story_dir:[ \t]*(.*)$', m.group(1), re.M)
    if not d: continue
    v = d.group(1).strip().strip('"\'').rstrip("/")
    if not v: continue
    try:
        if pathlib.Path(os.path.expanduser(v)).resolve() == target:
            print(f); break
    except Exception: pass
PYFIND
)"

if [[ -n "$STORY_PAGE" ]]; then
    if [[ $DRY_RUN -eq 1 ]]; then
        if [[ "$MEDIA_MOVED" == "1" ]]; then
            echo "Story page: would set status: published and media_archive in $(basename "$STORY_PAGE")"
        else
            echo "Story page: would set status: published in $(basename "$STORY_PAGE") (no media moved)"
        fi
    else
        STORY_PAGE="$STORY_PAGE" MEDIA_DEST="$MEDIA_DEST" MEDIA_MOVED="$MEDIA_MOVED" python3 - <<'PYSET'
import os, re, pathlib
p = pathlib.Path(os.environ["STORY_PAGE"])
t = p.read_text()
m = re.match(r'^---\s*\n(.*?)\n---\s*\n?', t, re.S)
if m:
    fm, body = m.group(1), t[m.end():]
    def setk(fm, k, v):
        if re.search(rf'^{k}:', fm, re.M):
            return re.sub(rf'^{k}:.*$', f'{k}: {v}', fm, count=1, flags=re.M)
        return fm.rstrip("\n") + f"\n{k}: {v}"
    fm = setk(fm, "status", "published")
    if os.environ.get("MEDIA_MOVED") == "1":
        fm = setk(fm, "media_archive", f'"{os.environ["MEDIA_DEST"]}"')
    new = f"---\n{fm}\n---\n{body}"
    if new != t:
        p.write_text(new)
        print(f"Story page: {p.name} → status: published" +
              (", media_archive recorded" if os.environ.get("MEDIA_MOVED") == "1" else ""))
    else:
        print(f"Story page: {p.name} already current")
PYSET
    fi
else
    echo "Story page: none found with story_dir → $STORY_DIR"
    echo "  Create ~/notebook/pages/${SLUG} (story).md with:"
    echo "    type: story, status: published, story_dir: \"$STORY_DIR\""
    [[ "$MEDIA_MOVED" == "1" ]] && echo "    media_archive: \"$MEDIA_DEST\""
fi
echo ""

if [[ $DRY_RUN -eq 1 ]]; then
    echo "*** DRY RUN — nothing was changed. Re-run without --dry-run to apply. ***"
    exit 0
fi

echo "Next steps (use Claude):"
echo "  1. Add frontmatter + wikilinks to text files in $ARCHIVE"
echo "     (tag each with story: \"[[${SLUG} (story)]]\")"
echo "  2. Story index page: ~/notebook/pages/${SLUG} (story).md"
echo "     — status and media_archive are set above if the page already existed"
echo "     — link assets from $ASSETS/$SLUG/ at bottom of page"
echo "  3. Create/update entity pages for people, orgs, events, places"
echo "  4. Fold working notes into entity pages as subheadings"
